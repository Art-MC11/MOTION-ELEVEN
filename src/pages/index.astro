---
import Base from "../layouts/Base.astro";
import FunnelStart from "../components/FunnelStart.astro";
import ServicesGrid from "../components/ServicesGrid.astro";
import VideoWall from "../components/VideoWall.astro";
import ShowreelExpand from "../components/ShowreelExpand.astro";
import HorizontalReel from "../components/HorizontalReel.astro";
import ShowreelModal from "../components/ShowreelModal.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import Offers from "../components/Offers.astro";
import Testimonials from "../components/Testimonials.astro";
import BookingSimulator from "../components/BookingSimulator.astro";
import Faq from "../components/Faq.astro";
import { projects, faq, sectors } from "../data/content";
import { site } from "../data/site";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  inLanguage: "fr-FR",
  publisher: { "@id": `${site.url}/#organisation` },
};
const videoSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "Showreel Motion Eleven",
  description: "Showreel de motion design, 3D et publicité réalisé par Motion Eleven.",
  thumbnailUrl: `${site.url}/images/showreel/hero-poster.jpg`,
  contentUrl: `${site.url}/media/showreel-720.mp4`,
  uploadDate: "2025-01-01",
  duration: "PT50S",
};
const reasons = [
  { n: "48 h", count: 48, suffix: " h", t: "pour recevoir votre devis", d: "Contenu, délai, prix : une proposition claire et chiffrée, sans engagement." },
  { n: "2 sem.", count: 2, suffix: " sem.", t: "pour un site vitrine en ligne", d: "Dès réception de vos contenus. Une boutique en ligne prend 4 à 6 semaines." },
  { n: "1", count: 1, suffix: "", t: "seul interlocuteur", d: "La même personne du premier appel à la maintenance. Pas de transfert de dossier." },
];
const project = projects[0];
---
<Base
  title="Motion Eleven — Agence digitale & motion design à Paris : sites internet, e-commerce, vidéo"
  description="Création de sites internet, e-commerce, automatisation et motion design pour les entreprises de Paris et d'Île-de-France. Dès 590 € HT. Rendez-vous en ligne, réponse sous 24 h."
  schema={[websiteSchema, faqSchema, videoSchema]}
>
  <!-- Hero vidéo plein écran -->
  <section class="hero" data-scrub="leave">
    <video class="hero__video" autoplay muted loop playsinline poster="/images/showreel/hero-poster.jpg" aria-hidden="true" data-hero-video>
      <source src="/media/hero-1280.mp4" type="video/mp4" media="(min-width: 761px)" />
      <source src="/media/hero-854.mp4" type="video/mp4" />
    </video>
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1>Votre présence digitale à la hauteur de vos ambitions.</h1>
        <p class="hero__sub">Sites internet, boutiques en ligne, automatisations et vidéos pour les entreprises de Paris et d'Île-de-France. Dès 590&nbsp;€&nbsp;HT.</p>
        <div class="btns" data-spread>
          <a class="btn" href="#rendez-vous" data-track="cta_click" data-label="hero_rdv">Réserver un créneau</a>
          <a class="btn btn--ghost" href="/realisations/" data-track="cta_click" data-label="hero_realisations">Voir nos réalisations</a>
        </div>
        <button class="hero__reel" type="button" data-showreel data-t="0">
          <span aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
          Voir le showreel
        </button>
        <ul class="hero__badges" data-pop>
          <li style="--i:0">Devis gratuit sous 48 h</li>
          <li style="--i:1">Maintenance incluse</li>
          <li style="--i:2">Réponse sous 24 h</li>
        </ul>
      </div>
      <div class="hero__funnel"><FunnelStart /></div>
    </div>
  </section>

  <!-- Mur de vidéos -->
  <VideoWall />

  <!-- Phrase révélée au défilement -->
  <section class="stm" data-scrub="through" data-words aria-label="Notre approche">
    <div class="wrap stm__grid">
      <p class="stm__text" data-split>Nous créons des sites, des vidéos et des outils qui donnent envie de vous appeler. Le design attire, la technique convertit, et vous gardez un seul interlocuteur.</p>
      <div class="pills" aria-hidden="true">
        <span class="pill" style="--i:0">Attirer</span>
        <span class="pill" style="--i:1">Captiver</span>
        <span class="pill" style="--i:2">Convertir</span>
        <span class="pill" style="--i:3">Fidéliser</span>
      </div>
    </div>
  </section>

  <!-- Showreel qui s'ouvre -->
  <ShowreelExpand />

  <!-- Services -->
  <section class="section" aria-labelledby="services">
    <div class="wrap">
      <div class="head head--split">
        <h2 id="services">Nos services</h2>
        <p class="lede">Quatre expertises réunies chez un seul interlocuteur, pour attirer des clients et vous faire gagner du temps.</p>
      </div>
      <ServicesGrid />
    </div>
  </section>

  <!-- Activités -->
  <section class="sect" aria-label="Solutions par activité">
    <div class="wrap sect__inner">
      <p>Vous êtes</p>
      <ul>{sectors.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
    </div>
  </section>

  <!-- Galerie horizontale -->
  <HorizontalReel />

  <!-- Pourquoi nous choisir -->
  <section class="section section--ink" aria-labelledby="pourquoi">
    <div class="wrap">
      <div class="head"><h2 id="pourquoi">Pourquoi nous choisir</h2></div>
      <div class="why">
        {reasons.map((r) => (
          <div class="why__item">
            <p class="why__n" data-count={r.count} data-suffix={r.suffix}>{r.n}</p>
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Offres -->
  <section class="section" aria-labelledby="offres">
    <div class="wrap">
      <div class="head head--split">
        <h2 id="offres">Des prix clairs</h2>
        <p class="lede">Un prix de création, puis un abonnement qui couvre l'hébergement, la sécurité et vos modifications.</p>
      </div>
      <Offers />
    </div>
  </section>

  <!-- Réalisation + modèle -->
  <section class="section section--chalk" aria-labelledby="realisation">
    <div class="wrap case">
      <ProjectVisual project={project} />
      <div class="case__text">
        <p class="case__k">Réalisation</p>
        <h2 id="realisation">{project.name}</h2>
        <p class="lede">{project.summary}</p>
        <ul class="ticks small">{project.features.slice(0, 4).map((f) => <li>{f}</li>)}</ul>
        <div class="btns">
          <a class="btn" href={`/realisations/${project.slug}/`}>Voir l'étude de cas</a>
          <a class="btn btn--ghost" href="/modeles/">Tester nos modèles de sites</a>
        </div>
      </div>
    </div>
  </section>

  <Testimonials />

  <!-- Prise de rendez-vous -->
  <section class="section" id="rendez-vous" aria-label="Prendre rendez-vous">
    <div class="wrap"><BookingSimulator /></div>
  </section>

  <section class="section section--chalk" aria-label="Questions fréquentes">
    <div class="wrap"><Faq items={faq} /></div>
  </section>

  <ShowreelModal />
</Base>

<style>
  .hero { position: relative; min-height: calc(100svh - 78px); display: grid; align-items: center; overflow: hidden; margin-top: -1px; }
  .hero__video, .hero__shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__video { object-fit: cover; transform: scale(calc(1 + var(--p, 0) * 0.18)); transform-origin: 50% 30%; }
  .hero__grid { transform: translate3d(0, calc(var(--p, 0) * -90px), 0); opacity: calc(1 - var(--p, 0) * 1.3); }
  .hero__shade {
    background:
      linear-gradient(90deg, rgba(10, 10, 11, 0.92) 0%, rgba(10, 10, 11, 0.7) 45%, rgba(10, 10, 11, 0.35) 100%),
      linear-gradient(0deg, rgba(10, 10, 11, 0.95) 0%, transparent 35%);
  }
  .hero__grid {
    position: relative; display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  .hero__text { display: grid; gap: 1.6rem; justify-items: start; }
  .hero h1 { font-size: clamp(2.5rem, 1.4rem + 4.4vw, 5.6rem); max-width: 14ch; }
  .hero__sub { margin: 0; font-size: var(--t-md); line-height: 1.55; color: #c9c9c5; max-width: 40ch; }
  .hero__reel {
    display: inline-flex; align-items: center; gap: 0.75rem; background: none; border: 0; padding: 0;
    color: var(--ink); font: inherit; font-weight: 600; cursor: pointer;
  }
  .hero__reel span {
    width: 46px; height: 46px; border-radius: 999px; display: grid; place-items: center;
    border: 1.5px solid var(--cobalt); color: var(--cobalt); transition: background 0.2s, color 0.2s;
  }
  .hero__reel svg { width: 16px; height: 16px; margin-left: 2px; }
  .hero__reel:hover span { background: var(--cobalt); color: var(--on-accent); }
  .hero__badges { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .hero__badges li {
    display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.45rem 0.9rem; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18); background: rgba(10, 10, 11, 0.45); font-size: var(--t-xs); font-weight: 600;
  }
  .hero__badges li::before { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--cobalt); }
  @media (max-width: 1000px) { .hero__grid { grid-template-columns: 1fr; } .hero { min-height: auto; } }
  @media (max-width: 600px) {
    .hero h1 { font-size: clamp(2.2rem, 1.2rem + 6vw, 3rem); }
    .hero__sub { font-size: var(--t-base); }
    .hero__shade { background: linear-gradient(180deg, rgba(10, 10, 11, 0.55) 0%, rgba(10, 10, 11, 0.85) 55%, rgba(10, 10, 11, 1) 100%); }
  }

  .sect { border-block: 1px solid var(--line); }
  .sect__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; padding-block: 1.2rem; }
  .sect__inner p { margin: 0; color: var(--ink-soft); font-size: var(--t-sm); }
  .sect ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .sect a {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 1.1rem; border-radius: 999px;
    border: 1.5px solid var(--line); text-decoration: none; font-weight: 600; font-size: var(--t-sm);
  }
  .sect a:hover { border-color: var(--cobalt); color: var(--cobalt); }

  .stm { padding-block: clamp(5rem, 14vw, 11rem); overflow: hidden; }
  .stm__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(2.5rem, 6vw, 6rem); align-items: center; }
  @media (max-width: 900px) { .stm__grid { grid-template-columns: 1fr; } }
  .stm__text {
    margin: 0; max-width: 24ch; font-size: clamp(2rem, 1rem + 4.2vw, 5rem); line-height: 1.08;
    font-weight: 560; font-stretch: 88%; text-transform: uppercase; letter-spacing: 0;
  }

  .why { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.5rem, 4vw, 3.5rem); }
  .why__item { border-top: 1px solid rgba(255, 255, 255, 0.2); padding-top: 1.75rem; display: grid; gap: 0.8rem; align-content: start; }
  .why__n { margin: 0; font-size: clamp(3.5rem, 2rem + 5vw, 6.5rem); font-weight: 520; font-stretch: 88%; line-height: 0.95; color: var(--cobalt); }
  .why__item h3 { text-transform: uppercase; font-weight: 560; font-stretch: 88%; letter-spacing: 0.01em; }
  .why__item p:last-child { color: #b9b9be; }
  @media (max-width: 860px) { .why { grid-template-columns: 1fr; } }

  .case { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .case__text { display: grid; gap: 1.2rem; justify-items: start; }
  .case__k { margin: 0; color: var(--cobalt); font-weight: 620; }
  .case .btns { margin-top: 0.5rem; }
  @media (max-width: 900px) { .case { grid-template-columns: 1fr; } }
</style>

<script>
  const v = document.querySelector<HTMLVideoElement>("[data-hero-video]");
  if (v && matchMedia("(prefers-reduced-motion: reduce)").matches) { v.removeAttribute("autoplay"); v.pause(); }
</script>
