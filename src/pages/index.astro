---
import Base from "../layouts/Base.astro";
import FunnelStart from "../components/FunnelStart.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import Offers from "../components/Offers.astro";
import Testimonials from "../components/Testimonials.astro";
import Faq from "../components/Faq.astro";
import CtaFinal from "../components/CtaFinal.astro";
import { projects, faq, sectors } from "../data/content";
import { site } from "../data/site";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  inLanguage: "fr-FR",
  publisher: { "@id": `${site.url}/#organisation` },
};
const steps = [
  { t: "Vous répondez à 5 questions", d: "1 minute, depuis votre téléphone." },
  { t: "On vous rappelle sous 24 h", d: "30 minutes pour cadrer votre projet." },
  { t: "Devis clair sous 48 h", d: "Contenu, délai, prix. Vous décidez." },
  { t: "Votre site en ligne", d: "Dès 2 semaines, maintenance comprise." },
];
const project = projects[0];
---
<Base
  title="Motion Eleven — Création de site internet en Île-de-France, devis gratuit en 1 minute"
  description="Sites internet, boutiques en ligne et automatisations pour indépendants, artisans, restaurants et PME en Île-de-France. Dès 590 € HT. Devis gratuit en 1 minute, réponse sous 24 h."
  schema={[websiteSchema, faqSchema]}
>
  <!-- Hero + entrée du tunnel -->
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <h1>Votre entreprise mérite une présence digitale à la hauteur de vos ambitions.</h1>
        <p class="lede">Sites internet, boutiques en ligne et outils qui vous apportent des clients. Dès 590&nbsp;€&nbsp;HT.</p>
        <ul class="hero__proof">
          <li>Devis gratuit sous 48 h</li>
          <li>Interlocuteur unique</li>
          <li>Paris et Île-de-France</li>
        </ul>
      </div>
      <FunnelStart />
    </div>
  </section>

  <!-- Activités : accès direct -->
  <section class="sect" aria-label="Solutions par activité">
    <div class="wrap sect__inner">
      <p>Vous êtes</p>
      <ul>
        {sectors.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- Offres -->
  <section class="section section--chalk" aria-labelledby="offres">
    <div class="wrap">
      <div class="head"><h2 id="offres">Des prix clairs, affichés.</h2></div>
      <Offers />
    </div>
  </section>

  <!-- Preuve -->
  <section class="section" aria-labelledby="realisation">
    <div class="wrap case">
      <ProjectVisual project={project} />
      <div class="case__text">
        <p class="case__k">Réalisation</p>
        <h2 id="realisation">{project.name}</h2>
        <p class="lede">{project.summary}</p>
        <ul class="ticks small">{project.features.slice(0, 4).map((f) => <li>{f}</li>)}</ul>
        <div class="btns">
          <a class="btn" href="/devis/?projet=reservation" data-track="cta_click" data-label="case_devis">Je veux le même résultat</a>
          <a class="btn btn--ghost" href={`/realisations/${project.slug}/`}>Voir l'étude de cas</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Comment ça marche -->
  <section class="section section--ink" aria-labelledby="methode">
    <div class="wrap">
      <div class="head head--split">
        <h2 id="methode">De la demande à la mise en ligne.</h2>
        <div><a class="btn btn--light" href="/devis/" data-track="cta_click" data-label="methode_devis">Commencer mon devis</a></div>
      </div>
      <ol class="flow">
        {steps.map((s, i) => (
          <li><span>{i + 1}</span><strong>{s.t}</strong><em>{s.d}</em></li>
        ))}
      </ol>
    </div>
  </section>

  <Testimonials />

  <section class="section" aria-label="Questions fréquentes">
    <div class="wrap"><Faq items={faq} /></div>
  </section>

  <CtaFinal />
</Base>

<style>
  .hero { padding: clamp(1.5rem, 5vw, 4.5rem) 0 clamp(2.5rem, 5vw, 4.5rem); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero__text { display: grid; gap: 1.4rem; }
  .hero h1 { font-size: clamp(2rem, 1.2rem + 2.8vw, 3.6rem); max-width: 17ch; }
  .hero .lede { max-width: 36ch; }
  .hero__proof { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: var(--t-sm); font-weight: 600; }
  .hero__proof li { position: relative; padding-left: 1.4rem; }
  .hero__proof li::before {
    content: ""; position: absolute; left: 0; top: 0.45em; width: 0.8rem; height: 0.45rem;
    border-left: 2px solid var(--lead); border-bottom: 2px solid var(--lead); transform: rotate(-45deg);
  }
  @media (max-width: 960px) { .hero__grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .hero h1 { font-size: 1.85rem; } .hero .lede { font-size: var(--t-base); } .hero__proof { display: none; } }

  .sect { border-block: 1px solid var(--line); }
  .sect__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; padding-block: 1.1rem; }
  .sect__inner p { margin: 0; color: var(--ink-soft); font-size: var(--t-sm); }
  .sect ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .sect a {
    display: inline-flex; align-items: center; min-height: 40px; padding: 0 1rem; border-radius: var(--r-pill);
    border: 1.5px solid var(--line); text-decoration: none; font-weight: 600; font-size: var(--t-sm);
  }
  .sect a:hover { border-color: var(--ink); color: var(--ink); }

  .case { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .case__text { display: grid; gap: 1.1rem; justify-items: start; }
  .case__k { margin: 0; color: var(--cobalt); font-weight: 620; }
  .case .btns { margin-top: 0.5rem; }
  @media (max-width: 900px) { .case { grid-template-columns: 1fr; } }

  .flow { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  .flow li { display: grid; gap: 0.35rem; align-content: start; border-top: 1px solid var(--line-dark); padding-top: 1.25rem; }
  .flow span { font-size: 2.6rem; font-weight: 760; font-stretch: 125%; line-height: 1; color: #8f9cff; margin-bottom: 0.5rem; }
  .flow strong { color: #fff; font-size: var(--t-md); line-height: 1.25; }
  .flow em { font-style: normal; color: #aab3cc; font-size: var(--t-sm); }
  @media (max-width: 900px) { .flow { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .flow { grid-template-columns: 1fr; } }
</style>
