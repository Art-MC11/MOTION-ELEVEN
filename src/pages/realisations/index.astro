---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import CtaFinal from "../../components/CtaFinal.astro";
import { projects } from "../../data/content";
import { site } from "../../data/site";
---
<Base
  title="Réalisations : études de cas de sites internet | Motion Eleven"
  description="Nos réalisations en détail : La Photo Minute, site de location de borne photo avec réservation et acompte en ligne."
  crumbs={[{ name: "Réalisations", href: "/realisations/" }]}
>
  <PageHero
    title="Nos réalisations, du problème à la solution."
    lede="Chaque projet est présenté avec son contexte, ce qu'il fallait résoudre et ce que nous avons construit. Les sites sont en ligne : vous pouvez les visiter."
    primary={{ label: "Lancer mon projet", href: "/devis/" }}
  />

  <section class="section section--chalk">
    <div class:list={["wrap", "rl", { "rl--single": projects.length === 1 }]}>
      {projects.map((p) => (
        <a class="rl__item" href={`/realisations/${p.slug}/`}>
          <ProjectVisual project={p} />
          <div class="rl__text">
            <p class="rl__sector">{p.sector}</p>
            <h2>{p.name}</h2>
            <p>{p.summary}</p>
            <span class="link">Lire l'étude de cas</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap rl__motion">
      <div>
        <h2>Motion design</h2>
        <p class="lede">Animations de logo, Reels, vidéos promo et systèmes visuels sont réunis sur notre portfolio dédié.</p>
      </div>
      <a class="btn btn--ghost" href={site.portfolioMotion} target="_blank" rel="noopener">Voir le portfolio motion design</a>
    </div>
  </section>

  <CtaFinal title="Votre projet pourrait être le prochain." />
</Base>

<style>
  .rl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(2rem, 4vw, 3rem); }
  .rl__item { display: grid; gap: 1.75rem; text-decoration: none; color: var(--ink); align-content: start; }
  .rl__item:hover { color: var(--ink); }
  .rl__item:hover h2 { color: var(--cobalt); }
  .rl__sector { color: var(--cobalt); font-weight: 620; margin-bottom: 0.4rem; }
  .rl__text h2 { font-size: var(--t-lg); margin-bottom: 0.75rem; transition: color 0.2s; }
  .rl__text p { color: var(--ink-soft); }
  .rl__text .link { display: inline-block; margin-top: 0.5rem; }
  @media (max-width: 860px) { .rl { grid-template-columns: 1fr; } }
  .rl--single { grid-template-columns: 1fr; }
  .rl--single .rl__item { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); }
  @media (max-width: 860px) { .rl--single .rl__item { grid-template-columns: 1fr; } }
  .rl__motion { display: flex; flex-wrap: wrap; gap: 2rem; justify-content: space-between; align-items: end; }
  .rl__motion h2 { margin-bottom: 1rem; }
</style>
