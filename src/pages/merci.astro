---
import Base from "../layouts/Base.astro";
import { site, whatsappLink } from "../data/site";
---
<Base title="Merci | Motion Eleven" description="Votre demande a bien été envoyée." noindex>
  <section class="mc">
    <div class="wrap mc__inner">
      <span class="mc__badge" aria-hidden="true">
        <svg viewBox="0 0 20 20"><path d="M4 10.5 8 14l8-8" fill="none" stroke="currentColor" stroke-width="2.2" /></svg>
      </span>
      <h1 data-title>Votre demande est bien arrivée.</h1>
      <p class="lede" data-text>Nous la lisons et revenons vers vous sous 24 h ouvrées. Vous recevrez une proposition claire et chiffrée sous 48 h.</p>
      <div class="btns">
        <a class="btn" href="/realisations/">Découvrir nos réalisations</a>
        <a class="btn btn--ghost" href={whatsappLink("Bonjour, je viens d'envoyer une demande sur votre site.")} target="_blank" rel="noopener">Compléter sur WhatsApp</a>
      </div>
      <p class="small muted">Une urgence ? Appelez le <a href={site.phoneHref}>{site.phone}</a>.</p>
    </div>
  </section>
</Base>

<script>
  const p = new URLSearchParams(location.search);
  const t = document.querySelector("[data-title]");
  const x = document.querySelector("[data-text]");
  if (p.get("paiement") === "ok") {
    if (t) t.textContent = "Paiement reçu, merci pour votre confiance.";
    if (x) x.textContent = "Votre acompte est enregistré et un reçu vous est envoyé par Stripe. Nous vous contactons sous 24 h ouvrées pour lancer votre projet.";
    const key = "me-purchase-" + (p.get("session_id") || "");
    try {
      if (!sessionStorage.getItem(key)) {
        sessionStorage.setItem(key, "1");
        window.meTrack?.("purchase", { offer: p.get("formule") || undefined, transaction_id: p.get("session_id") || undefined });
      }
    } catch { /* */ }
  } else if (p.get("type") === "rendez-vous") {
    if (t) t.textContent = "Votre demande de rendez-vous est enregistrée.";
    if (x) x.textContent = "Nous vous confirmons l'horaire exact par e-mail ou par message sous 24 h ouvrées.";
  }
</script>

<style>
  .mc { padding: clamp(4rem, 10vw, 8rem) 0; }
  .mc__inner { display: grid; gap: 1.5rem; justify-items: start; max-width: 760px; }
  .mc__badge { width: 56px; height: 56px; border-radius: 50%; background: var(--lead); color: #fff; display: grid; place-items: center; }
  .mc__badge svg { width: 28px; height: 28px; }
  .mc h1 { font-size: var(--t-xl); }
</style>
