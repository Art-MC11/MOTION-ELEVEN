---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import { site, whatsappLink } from "../data/site";
---
<Base
  title="Devis gratuit site internet en 1 minute | Motion Eleven"
  description="Obtenez votre devis gratuit pour un site internet, une boutique en ligne ou une automatisation. 5 questions, réponse sous 24 h, sans engagement."
  crumbs={[{ name: "Devis gratuit", href: "/devis/" }]}
  hideFab
>
  <section class="dv">
    <div class="wrap dv__inner">
      <h1>Votre devis gratuit en 1 minute</h1>
      <ul class="dv__trust">
        <li>Réponse sous 24 h</li>
        <li>Sans engagement</li>
        <li>Dès 590 € HT</li>
      </ul>
      <div class="dv__card"><LeadForm /></div>
      <p class="dv__alt">
        Plutôt en direct ?
        <a href={whatsappLink("Bonjour, je souhaite un devis pour mon projet.")} target="_blank" rel="noopener">WhatsApp</a>,
        <a href={site.phoneHref}>{site.phone}</a> ou
        <a href="/contact/#rendez-vous">réserver un appel</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .dv { padding: clamp(1rem, 3vw, 2rem) 0 var(--section); }
  .dv__inner { max-width: 760px; display: grid; gap: 1.25rem; }
  .dv h1 { font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem); }
  .dv__trust { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: var(--t-sm); font-weight: 600; }
  .dv__trust li { position: relative; padding-left: 1.4rem; }
  .dv__trust li::before {
    content: ""; position: absolute; left: 0; top: 0.45em; width: 0.8rem; height: 0.45rem;
    border-left: 2px solid var(--lead); border-bottom: 2px solid var(--lead); transform: rotate(-45deg);
  }
  .dv__card { background: var(--chalk); border-radius: var(--r-frame); padding: clamp(1.1rem, 4vw, 2.25rem); }
  .dv__alt { font-size: var(--t-sm); color: var(--ink-soft); }
  .dv__alt a { color: var(--ink); font-weight: 600; }
</style>
