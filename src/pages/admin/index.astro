---
import "../../styles/global.css";
import "../../styles/admin.css";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0c1530" />
    <title>Motion Eleven — Espace admin</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/archivo.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="adm">
    <!-- Connexion -->
    <main id="login" class="login" hidden>
      <form id="login-form" class="login__box">
        <div class="login__logo"><svg viewBox="0 0 28 28" aria-hidden="true"><rect x="6" y="5" width="5.5" height="18" rx="2.75" /><rect x="16.5" y="2" width="5.5" height="18" rx="2.75" fill="#5b6dff" /></svg> Motion Eleven</div>
        <h1>Espace admin</h1>
        <label class="fld"><span>Mot de passe</span><input id="pw" type="password" autocomplete="current-password" required autofocus /></label>
        <p id="login-error" class="err" hidden></p>
        <button class="btn btn--wide" type="submit">Se connecter</button>
      </form>
    </main>

    <!-- Application -->
    <div id="app" hidden>
      <header class="top">
        <div class="top__brand"><svg viewBox="0 0 28 28" aria-hidden="true"><rect x="6" y="5" width="5.5" height="18" rx="2.75" /><rect x="16.5" y="2" width="5.5" height="18" rx="2.75" fill="#5b6dff" /></svg><span>Motion Eleven</span></div>
        <nav class="nav" aria-label="Sections">
          <a href="#accueil" data-view="accueil"><i>◧</i>Accueil</a>
          <a href="#prospecter" data-view="prospecter"><i>⌕</i>Prospecter</a>
          <a href="#contacts" data-view="contacts"><i>☰</i>Contacts</a>
          <a href="#messages" data-view="messages"><i>✉︎</i>Messages</a>
          <a href="#reglages" data-view="reglages"><i>⚙︎</i>Réglages</a>
        </nav>
        <button id="logout" class="top__out">Déconnexion</button>
      </header>

      <main class="main">
        <!-- Accueil -->
        <section id="v-accueil" class="view" hidden>
          <h1>Tableau de bord</h1>
          <div id="v-accueil-body"></div>
        </section>

        <!-- Prospection -->
        <section id="v-prospecter" class="view" hidden>
          <h1>Trouver des clients</h1>
          <form id="search-form" class="card search">
            <fieldset class="seg">
              <legend class="visually-hidden">Source</legend>
              <label><input type="radio" name="source" value="osm" checked /><span><b>Commerces sans site</b><em>OpenStreetMap, gratuit</em></span></label>
              <label><input type="radio" name="source" value="entreprises" /><span><b>Annuaire officiel</b><em>Toutes les entreprises actives</em></span></label>
              <label><input type="radio" name="source" value="google" id="src-google" /><span><b>Google Maps</b><em id="src-google-hint">Clé API requise</em></span></label>
            </fieldset>
            <div class="grid2">
              <label class="fld"><span>Activité</span><select id="s-activity"></select></label>
              <label class="fld"><span>Ville ou code postal</span><input id="s-city" placeholder="Ex. : Sarcelles, 95200" required /></label>
            </div>
            <div class="grid2">
              <label class="fld" id="radius-field"><span>Rayon</span>
                <select id="s-radius"><option value="2">2 km</option><option value="5" selected>5 km</option><option value="10">10 km</option><option value="20">20 km</option></select>
              </label>
              <label class="check" id="nosite-field"><input type="checkbox" id="s-nosite" /> Seulement les entreprises sans site</label>
            </div>
            <button class="btn btn--wide" type="submit">Rechercher</button>
          </form>
          <div id="results"></div>
          <div id="pick-bar" class="bar" hidden>
            <span><b id="pick-count">0</b> sélectionné(s)</span>
            <button class="btn btn--sm" id="pick-add">Ajouter au CRM</button>
          </div>
        </section>

        <!-- Contacts -->
        <section id="v-contacts" class="view" hidden>
          <div class="vhead">
            <h1>Contacts</h1>
            <div class="btns"><button class="btn btn--sm btn--ghost" id="export">Exporter</button><button class="btn btn--sm" id="add-contact">Ajouter</button></div>
          </div>
          <input id="c-search" class="search-in" type="search" placeholder="Rechercher un nom, une ville, un téléphone…" aria-label="Rechercher" />
          <div id="filters" class="chips"></div>
          <div id="contact-list" class="clist"></div>
          <div id="sel-bar" class="bar" hidden>
            <span><b id="sel-count">0</b> sélectionné(s)</span>
            <button class="btn btn--sm btn--ghost" id="sel-clear">Annuler</button>
            <button class="btn btn--sm" id="sel-email">Envoyer un e-mail</button>
          </div>
        </section>

        <!-- Messages -->
        <section id="v-messages" class="view" hidden>
          <h1>Messages</h1>
          <form id="campaign" class="card">
            <h2>Campagne e-mail</h2>
            <p id="cg-email-off" class="warn">L'envoi automatique nécessite Resend (voir Réglages). En attendant, envoyez vos messages un par un depuis la fiche du contact.</p>
            <div class="grid2">
              <label class="fld"><span>Destinataires</span>
                <select id="cg-target">
                  <option value="nouveaux">Prospects jamais contactés</option>
                  <option value="relance">Contactés, relance prévue aujourd'hui</option>
                  <option value="interesses">Intéressés et devis envoyés</option>
                  <option value="selection">Ma sélection (page Contacts)</option>
                </select>
              </label>
              <label class="fld"><span>Modèle</span><select id="cg-tpl"></select></label>
            </div>
            <p id="cg-count" class="muted small"></p>
            <label class="fld"><span>Objet</span><input id="cg-subject" required /></label>
            <label class="fld"><span>Message</span><textarea id="cg-body" rows="10" required></textarea></label>
            <p class="muted small">Variables : {"{{entreprise}} {{nom}} {{ville}} {{a_ville}} {{activite}} {{un_activite}} {{signature}}"}. Chaque e-mail est personnalisé et contient un lien de désinscription.</p>
            <button class="btn btn--wide" type="submit">Envoyer la campagne</button>
            <div id="cg-report"></div>
          </form>

          <section class="card">
            <div class="vhead"><h2>Modèles</h2><button class="btn btn--sm btn--ghost" id="tpl-new">Nouveau modèle</button></div>
            <div id="tpl-list" class="rows"></div>
            <form id="tpl-form" class="tplf" hidden>
              <div class="grid2">
                <label class="fld"><span>Nom</span><input id="t-name" required /></label>
                <label class="fld"><span>Canal</span><select id="t-channel"><option value="email">E-mail</option><option value="whatsapp">WhatsApp</option></select></label>
              </div>
              <label class="fld"><span>Objet (e-mail)</span><input id="t-subject" /></label>
              <label class="fld"><span>Message</span><textarea id="t-body" rows="9" required></textarea></label>
              <div class="btns">
                <button class="btn btn--sm" type="submit">Enregistrer</button>
                <button class="btn btn--sm btn--ghost" type="button" id="t-cancel">Annuler</button>
                <button class="btn btn--sm btn--ghost danger" type="button" id="t-del">Supprimer</button>
              </div>
            </form>
          </section>
        </section>

        <!-- Réglages -->
        <section id="v-reglages" class="view" hidden>
          <h1>Réglages</h1>
          <form id="settings-form" class="card">
            <h2>Signature des messages</h2>
            <label class="fld"><span>Nom de l'expéditeur</span><input id="st-sender" /></label>
            <label class="fld"><span>Signature</span><textarea id="st-signature" rows="5"></textarea></label>
            <label class="fld"><span>Limite d'e-mails par jour</span><input id="st-limit" type="number" min="1" max="200" /></label>
            <p class="muted small">Une limite raisonnable protège la réputation de votre adresse d'envoi. Commencez autour de 30 à 40 par jour.</p>
            <button class="btn" type="submit">Enregistrer</button>
          </form>
          <section class="card">
            <h2>Connexions</h2>
            <dl class="status">
              <div><dt>Envoi d'e-mails (Resend)</dt><dd id="st-email"></dd></div>
              <div><dt>Google Maps (Places API)</dt><dd id="st-google"></dd></div>
            </dl>
            <p class="muted small">Ces clés s'ajoutent dans Netlify, Project configuration, Environment variables : RESEND_API_KEY, RESEND_FROM (adresse de votre domaine vérifiée), GOOGLE_PLACES_API_KEY.</p>
          </section>
        </section>
      </main>
    </div>

    <dialog id="sheet" class="sheet"><div id="sheet-body" class="sheet__body"></div></dialog>
    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <script>
      import "../../scripts/admin/app";
    </script>
  </body>
</html>
