---
import "../../styles/global.css";
import "../../styles/forms.css";
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>CRM | Motion Eleven</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="adm">
    <header class="adm__bar">
      <strong>Motion Eleven</strong><span>Prospects</span>
      <button class="btn btn--sm btn--ghost" data-logout hidden>Se déconnecter</button>
    </header>

    <main class="adm__main">
      <form class="fm adm__login" data-login>
        <h1>Accès au CRM</h1>
        <div class="fm__field">
          <label class="fm__label" for="pw">Mot de passe</label>
          <input id="pw" type="password" name="password" required autocomplete="current-password" />
        </div>
        <p class="fm__error" data-login-error hidden></p>
        <button class="btn" type="submit">Se connecter</button>
      </form>

      <section data-app hidden>
        <div class="adm__stats" data-stats></div>
        <div class="adm__filters">
          <input type="search" placeholder="Rechercher un nom, une entreprise, un e-mail…" data-search aria-label="Rechercher" />
        </div>
        <div class="adm__board" data-board></div>
      </section>
    </main>

    <dialog class="adm__dlg" data-dialog>
      <form method="dialog" class="adm__dlg-close"><button class="btn btn--sm btn--ghost" aria-label="Fermer">Fermer</button></form>
      <div data-detail></div>
    </dialog>

    <script>
      type Lead = Record<string, any> & { id: string; status: string; name: string };
      const COLS: [string, string][] = [
        ["nouveau", "Nouveaux prospects"],
        ["contacte", "Contactés"],
        ["devis_envoye", "Devis envoyés"],
        ["gagne", "Clients gagnés"],
        ["perdu", "Clients perdus"],
      ];
      const TYPES: Record<string, string> = { devis: "Devis", rdv: "Rendez-vous", contact: "Contact", commande: "Commande payée" };
      const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
      const esc = (s: unknown) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
      let token = sessionStorage.getItem("me-admin") || "";
      let leads: Lead[] = [];

      async function api(method: string, body?: unknown) {
        const res = await fetch("/api/admin/leads", {
          method,
          headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: body ? JSON.stringify(body) : undefined,
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok) throw Object.assign(new Error(json.error || "Erreur"), { status: res.status });
        return json;
      }

      async function load() {
        try {
          const data = await api("GET");
          leads = data.leads;
          $("[data-login]").hidden = true;
          $("[data-app]").hidden = false;
          $("[data-logout]").hidden = false;
          render();
        } catch (e: any) {
          if (e.status === 401) { sessionStorage.removeItem("me-admin"); token = ""; }
          const box = $("[data-login-error]");
          box.textContent = e.message; box.hidden = false;
          $("[data-login]").hidden = false;
        }
      }

      function render() {
        const q = ($<HTMLInputElement>("[data-search]").value || "").toLowerCase();
        const list = leads.filter((l) => !q || [l.name, l.company, l.email, l.phone].join(" ").toLowerCase().includes(q));
        $("[data-stats]").innerHTML = COLS.map(([k, label]) =>
          `<div><span>${label}</span><strong>${leads.filter((l) => l.status === k).length}</strong></div>`).join("");
        $("[data-board]").innerHTML = COLS.map(([k, label]) => {
          const items = list.filter((l) => l.status === k);
          return `<div class="adm__col"><h2>${label} <em>${items.length}</em></h2>${items.map(card).join("") || '<p class="adm__empty">Aucun</p>'}</div>`;
        }).join("");
      }

      function card(l: Lead) {
        const d = new Date(l.created_at).toLocaleDateString("fr-FR", { day: "2-digit", month: "short" });
        return `<button class="adm__card" data-id="${esc(l.id)}">
          <span class="adm__type adm__type--${esc(l.type)}">${esc(TYPES[l.type] || l.type)}</span>
          <strong>${esc(l.name)}</strong>
          <span>${esc(l.company || l.sector || "")}</span>
          <span class="adm__meta">${esc(l.project_type || "")}${l.budget ? " — " + esc(l.budget) : ""}</span>
          <span class="adm__date">${d}</span>
        </button>`;
      }

      function detail(l: Lead) {
        const rows: [string, unknown][] = [
          ["Type", TYPES[l.type] || l.type], ["Reçu le", new Date(l.created_at).toLocaleString("fr-FR")],
          ["E-mail", l.email], ["Téléphone", l.phone], ["Entreprise", l.company], ["Secteur", l.sector],
          ["Projet", l.project_type], ["Formule", l.formule], ["Budget", l.budget], ["Délai", l.timeline],
          ["Rendez-vous", [l.appointment_date, l.appointment_slot, l.appointment_mode].filter(Boolean).join(" — ")],
          ["Montant", l.amount_cents ? (l.amount_cents / 100).toLocaleString("fr-FR") + " €" : ""],
          ["Page", l.source_page], ["Message", l.message],
        ];
        const phone = String(l.phone || "").replace(/[^0-9+]/g, "");
        const wa = phone.startsWith("0") ? "33" + phone.slice(1) : phone.replace("+", "");
        $("[data-detail]").innerHTML = `
          <h2>${esc(l.name)}</h2>
          <div class="adm__actions">
            ${l.email ? `<a class="btn btn--sm" href="mailto:${esc(l.email)}">E-mail</a>` : ""}
            ${phone ? `<a class="btn btn--sm btn--ghost" href="tel:${esc(phone)}">Appeler</a><a class="btn btn--sm btn--ghost" target="_blank" rel="noopener" href="https://wa.me/${esc(wa)}">WhatsApp</a>` : ""}
          </div>
          <dl class="adm__dl">${rows.filter(([, v]) => v).map(([k, v]) => `<div><dt>${k}</dt><dd>${esc(v).replace(/\n/g, "<br>")}</dd></div>`).join("")}</dl>
          <form class="fm" data-edit>
            <div class="fm__field"><label class="fm__label" for="st">Statut</label>
              <select id="st" name="status">${COLS.map(([k, label]) => `<option value="${k}" ${k === l.status ? "selected" : ""}>${label}</option>`).join("")}</select></div>
            <div class="fm__field"><label class="fm__label" for="nt">Notes</label>
              <textarea id="nt" name="notes">${esc(l.notes || "")}</textarea></div>
            <button class="btn" type="submit">Enregistrer</button>
          </form>`;
        $("[data-detail]").querySelector("form")!.addEventListener("submit", async (e) => {
          e.preventDefault();
          const f = new FormData(e.target as HTMLFormElement);
          const patch = { id: l.id, status: String(f.get("status")), notes: String(f.get("notes")) };
          await api("PATCH", patch);
          Object.assign(l, patch);
          ($<HTMLDialogElement>("[data-dialog]")).close();
          render();
        });
        ($<HTMLDialogElement>("[data-dialog]")).showModal();
      }

      $("[data-login]").addEventListener("submit", (e) => {
        e.preventDefault();
        token = String(new FormData(e.target as HTMLFormElement).get("password"));
        sessionStorage.setItem("me-admin", token);
        load();
      });
      $("[data-logout]").addEventListener("click", () => { sessionStorage.removeItem("me-admin"); location.reload(); });
      $("[data-search]").addEventListener("input", render);
      $("[data-board]").addEventListener("click", (e) => {
        const b = (e.target as HTMLElement).closest<HTMLElement>("[data-id]");
        const l = b && leads.find((x) => x.id === b.dataset.id);
        if (l) detail(l);
      });
      if (token) load();
    </script>

    <style>
      .adm { background: var(--chalk); min-height: 100vh; }
      .adm__bar { display: flex; align-items: center; gap: 0.75rem; padding: 1rem var(--gutter); background: var(--ink); color: #fff; }
      .adm__bar span { color: #aab3cc; }
      .adm__bar button { margin-left: auto; --btn-fg: #fff; border-color: #7d88ad; }
      .adm__main { padding: 1.5rem var(--gutter) 4rem; }
      .adm__login { max-width: 380px; margin: 10vh auto; background: #fff; padding: 2rem; border-radius: var(--r-frame); }
      .adm__login h1 { font-size: var(--t-lg); }
      .adm__stats { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0.75rem; margin-bottom: 1rem; }
      .adm__stats div { background: #fff; border-radius: 12px; padding: 0.9rem 1rem; display: grid; }
      .adm__stats span { font-size: var(--t-xs); color: var(--ink-soft); }
      .adm__stats strong { font-size: 1.8rem; font-stretch: 125%; }
      .adm__filters input { width: 100%; max-width: 420px; min-height: 46px; border: 1.5px solid var(--line); border-radius: var(--r-ui); padding: 0 1rem; font: inherit; margin-bottom: 1rem; }
      .adm__board { display: grid; grid-template-columns: repeat(5, minmax(220px, 1fr)); gap: 0.75rem; overflow-x: auto; padding-bottom: 1rem; }
      .adm__col { background: #e3e6ed; border-radius: 14px; padding: 0.75rem; display: grid; gap: 0.5rem; align-content: start; min-height: 200px; }
      .adm__col h2 { font-size: var(--t-sm); font-stretch: 100%; letter-spacing: 0; padding: 0.25rem 0.25rem 0.5rem; }
      .adm__col h2 em { font-style: normal; color: var(--ink-soft); font-weight: 500; }
      .adm__card { text-align: left; display: grid; gap: 0.15rem; background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 0.75rem; font: inherit; font-size: var(--t-sm); cursor: pointer; position: relative; }
      .adm__card:hover { border-color: var(--cobalt); }
      .adm__meta { color: var(--ink-soft); font-size: var(--t-xs); }
      .adm__date { position: absolute; right: 0.75rem; top: 0.75rem; font-size: var(--t-xs); color: var(--ink-soft); }
      .adm__type { justify-self: start; font-size: 11px; font-weight: 600; padding: 0.1rem 0.5rem; border-radius: 99px; background: var(--chalk); margin-bottom: 0.25rem; }
      .adm__type--rdv { background: var(--cobalt-tint); }
      .adm__type--commande { background: var(--lead-tint); }
      .adm__empty { color: var(--ink-soft); font-size: var(--t-xs); padding: 0.25rem; }
      .adm__dlg { border: 0; border-radius: var(--r-frame); padding: 1.75rem; width: min(640px, 94vw); max-height: 90vh; }
      .adm__dlg::backdrop { background: rgba(12, 21, 48, 0.5); }
      .adm__dlg h2 { font-size: var(--t-lg); margin-bottom: 1rem; }
      .adm__dlg-close { float: right; }
      .adm__actions { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }
      .adm__dl { display: grid; gap: 0.5rem; margin: 0 0 1.5rem; font-size: var(--t-sm); }
      .adm__dl div { display: grid; grid-template-columns: 110px 1fr; gap: 1rem; border-bottom: 1px solid var(--line); padding-bottom: 0.5rem; }
      .adm__dl dt { color: var(--ink-soft); }
      .adm__dl dd { margin: 0; word-break: break-word; }
      @media (max-width: 800px) { .adm__stats { grid-template-columns: repeat(2, 1fr); } }
    </style>
  </body>
</html>
