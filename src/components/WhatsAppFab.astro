---
import { whatsappLink } from "../data/site";
---
<a
  class="wa"
  href={whatsappLink()}
  target="_blank"
  rel="noopener"
  data-track="whatsapp_click"
  data-label="floating_button"
>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2c.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" /></svg>
  <span>WhatsApp</span>
</a>

<style>
  .wa {
    position: fixed; right: 1.1rem; bottom: 1.1rem; z-index: 40;
    display: inline-flex; align-items: center; gap: 0.5rem;
    height: 52px; padding: 0 1.1rem 0 0.9rem; border-radius: var(--r-pill);
    background: #1f1f22; color: #fff; border: 1px solid rgba(255,255,255,.18); text-decoration: none; font-weight: 620; font-size: var(--t-sm);
    box-shadow: 0 14px 30px -12px rgba(12, 21, 48, 0.55);
  }
  .wa:hover { background: #25d366; color: #0a0a0b; border-color: #25d366; }
  .wa svg { width: 22px; height: 22px; fill: currentColor; }
  @media (max-width: 760px) { .wa { display: none; } }
  @media print { .wa { display: none; } }
</style>
