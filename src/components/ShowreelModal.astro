---
// Lecteur du showreel complet. S'ouvre avec n'importe quel élément [data-showreel] (data-t = seconde de départ).
---
<dialog class="sr" data-showreel-dialog aria-label="Showreel Motion Eleven">
  <div class="sr__box">
    <button class="sr__close" type="button" data-showreel-close aria-label="Fermer le showreel">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" fill="none" /></svg>
    </button>
    <video class="sr__video" controls playsinline preload="none" poster="/images/showreel/hero-poster.jpg" data-showreel-video>
      <source src="/media/showreel-720.mp4" type="video/mp4" />
    </video>
  </div>
</dialog>

<style>
  .sr { border: 0; padding: 0; background: transparent; width: min(1200px, 94vw); max-width: none; max-height: none; }
  .sr::backdrop { background: rgba(5, 5, 6, 0.9); backdrop-filter: blur(6px); }
  .sr__box { position: relative; }
  .sr__video { width: 100%; aspect-ratio: 16 / 9; border-radius: 18px; background: #000; }
  .sr__close {
    position: absolute; top: -56px; right: 0; width: 44px; height: 44px; border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.3); background: transparent; color: #fff; cursor: pointer; display: grid; place-items: center;
  }
  .sr__close svg { width: 20px; height: 20px; }
  .sr__close:hover { background: var(--cobalt); color: var(--on-accent); border-color: var(--cobalt); }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>("[data-showreel-dialog]");
  const video = document.querySelector<HTMLVideoElement>("[data-showreel-video]");
  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-showreel]");
    if (!trigger || !dlg || !video) return;
    e.preventDefault();
    dlg.showModal();
    const t = Number(trigger.dataset.t || 0);
    const start = () => { try { video.currentTime = t; } catch { /* */ } video.play().catch(() => {}); };
    if (video.readyState >= 1) start(); else { video.load(); video.addEventListener("loadedmetadata", start, { once: true }); }
    window.meTrack?.("showreel_play", { from: t });
  });
  const close = () => { video?.pause(); dlg?.close(); };
  document.querySelector("[data-showreel-close]")?.addEventListener("click", close);
  dlg?.addEventListener("click", (e) => { if (e.target === dlg) close(); });
  dlg?.addEventListener("close", () => video?.pause());
</script>
