---
// Un site qui s'assemble, puis une demande de devis arrive.
// Illustration de ce que nous livrons ; un seul mouvement orchestré au chargement.
---
<figure class="ha" aria-label="Illustration : un site se construit et reçoit une demande de devis">
  <div class="ha__frame">
    <div class="ha__chrome">
      <span></span><span></span><span></span>
      <div class="ha__url">votre-entreprise.fr</div>
    </div>
    <div class="ha__page">
      <div class="ha__nav b b1">
        <i class="ha__dot"></i>
        <i class="ha__l w20"></i><i class="ha__l w12"></i><i class="ha__l w12"></i>
        <i class="ha__btn-s"></i>
      </div>
      <div class="ha__hero">
        <div>
          <i class="ha__h b b2"></i>
          <i class="ha__h ha__h--2 b b3"></i>
          <i class="ha__p b b4"></i>
          <i class="ha__p ha__p--2 b b4"></i>
          <i class="ha__cta b b5"></i>
        </div>
        <div class="ha__img b b3">
          <svg viewBox="0 0 120 90" aria-hidden="true"><path d="M0 70 32 42l22 18 26-30 40 40v20H0Z" /><circle cx="30" cy="22" r="9" /></svg>
        </div>
      </div>
      <div class="ha__cards">
        <i class="b b6"></i><i class="b b6"></i><i class="b b6"></i>
      </div>
    </div>
  </div>
  <div class="ha__toast" role="presentation">
    <span class="ha__badge" aria-hidden="true">
      <svg viewBox="0 0 20 20"><path d="M4 10.5 8 14l8-8" fill="none" stroke="currentColor" stroke-width="2.2" /></svg>
    </span>
    <span>
      <strong>Nouvelle demande de devis</strong>
      <span class="ha__sub">Restaurant, formule Business</span>
    </span>
  </div>
</figure>

<style>
  .ha { position: relative; margin: 0; padding: 0 0 2.5rem 0; }
  .ha__frame {
    background: #fff; border: 1px solid var(--line); border-radius: var(--r-frame);
    box-shadow: 0 40px 80px -40px rgba(12, 21, 48, 0.45);
    overflow: hidden; aspect-ratio: 4 / 3.3;
  }
  .ha__chrome {
    display: flex; align-items: center; gap: 6px; height: 38px; padding: 0 14px;
    border-bottom: 1px solid var(--line); background: #f7f8fa;
  }
  .ha__chrome > span { width: 9px; height: 9px; border-radius: 50%; background: var(--line); }
  .ha__url {
    margin-left: 14px; flex: 1; max-width: 220px; height: 22px; border-radius: 6px;
    background: #fff; border: 1px solid var(--line);
    font-size: 11px; line-height: 20px; padding: 0 10px; color: var(--ink-soft);
  }
  .ha__page { padding: 6% 7%; display: grid; gap: 9%; height: calc(100% - 38px); align-content: start; }
  .ha i { display: block; }

  .ha__nav { display: flex; align-items: center; gap: 8%; }
  .ha__dot { width: 16px; height: 16px; border-radius: 5px; background: var(--ink); }
  .ha__l { height: 6px; border-radius: 3px; background: var(--line); }
  .w20 { width: 20%; } .w12 { width: 12%; }
  .ha__btn-s { margin-left: auto; width: 16%; height: 18px; border-radius: 5px; background: var(--cobalt); }

  .ha__hero { display: grid; grid-template-columns: 1.15fr 1fr; gap: 8%; align-items: center; }
  .ha__h { height: 16px; border-radius: 4px; background: var(--ink); width: 92%; margin-bottom: 9px; }
  .ha__h--2 { width: 68%; margin-bottom: 16px; }
  .ha__p { height: 6px; border-radius: 3px; background: var(--line); width: 100%; margin-bottom: 7px; }
  .ha__p--2 { width: 76%; margin-bottom: 18px; }
  .ha__cta { width: 52%; height: 24px; border-radius: 6px; background: var(--cobalt); }
  .ha__img { aspect-ratio: 4 / 3; border-radius: 10px; background: var(--cobalt-tint); overflow: hidden; display: grid; place-items: end stretch; }
  .ha__img svg { width: 100%; fill: #c3c9ff; }

  .ha__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6%; }
  .ha__cards i { aspect-ratio: 1.4; border-radius: 8px; background: var(--chalk); border: 1px solid var(--line); }

  .ha__toast {
    position: absolute; left: -6%; bottom: 0; z-index: 2;
    display: flex; align-items: center; gap: 0.8rem;
    background: var(--ink); color: #fff; padding: 0.95rem 1.2rem 0.95rem 0.95rem;
    border-radius: 14px; box-shadow: 0 30px 60px -24px rgba(12, 21, 48, 0.7);
    font-size: var(--t-sm); line-height: 1.3;
  }
  .ha__toast strong { display: block; font-weight: 640; }
  .ha__sub { color: #aab3cc; font-size: var(--t-xs); }
  .ha__badge {
    flex: none; width: 34px; height: 34px; border-radius: 50%;
    display: grid; place-items: center; background: var(--lead); color: #fff;
  }
  .ha__badge svg { width: 18px; height: 18px; }

  /* Chorégraphie : les blocs se posent, puis la demande arrive */
  @media (prefers-reduced-motion: no-preference) {
    .b { animation: ha-in 0.7s var(--ease) both; }
    .b1 { animation-delay: 0.15s; }
    .b2 { animation-delay: 0.35s; }
    .b3 { animation-delay: 0.5s; }
    .b4 { animation-delay: 0.65s; }
    .b5 { animation-delay: 0.8s; }
    .b6 { animation-delay: 0.95s; }
    .ha__h.b2, .ha__h--2.b3 { transform-origin: left; animation-name: ha-grow; }
    .ha__toast { animation: ha-toast 0.8s var(--ease) 1.7s both; }
    .ha__badge { animation: ha-pop 0.5s var(--ease) 2.3s both; }
  }
  @keyframes ha-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
  @keyframes ha-grow { from { opacity: 0; transform: scaleX(0.2); } to { opacity: 1; transform: none; } }
  @keyframes ha-toast { from { opacity: 0; transform: translateY(24px) scale(0.96); } to { opacity: 1; transform: none; } }
  @keyframes ha-pop { 0% { transform: scale(0.4); } 70% { transform: scale(1.12); } 100% { transform: none; } }

  @media (max-width: 960px) {
    .ha__toast { left: 4%; }
  }
</style>
