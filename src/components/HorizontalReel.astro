---
// Galerie horizontale épinglée : la page se fige et les vidéos défilent de côté.
// Sur mobile : carrousel à faire glisser du doigt.
import { allClips } from "../data/content";
interface Props { title?: string; }
const { title = "Le savoir-faire en mouvement" } = Astro.props;
const items = allClips.slice(0, 8);
---
<section class="hr" data-scrub="pin" aria-labelledby="hr-title">
  <div class="hr__sticky">
    <div class="wrap hr__head">
      <h2 id="hr-title">{title}</h2>
      <div class="hr__aside">
        <p class="hr__count"><span>{String(items.length).padStart(2, "0")}</span> extraits du showreel</p>
        <button class="btn btn--ghost btn--sm" type="button" data-showreel data-t="0">Voir le showreel complet</button>
      </div>
    </div>
    <div class="hr__track">
      {items.map((c, i) => (
        <button class="hr__card" type="button" data-showreel data-t={c.t} aria-label={`Lire le showreel : ${c.title}`}>
          <span class="hr__media">
            <video muted loop playsinline preload="none" poster={c.poster} data-autoplay data-src={c.src} aria-hidden="true"></video>
            <span class="hr__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
          </span>
          <span class="hr__meta">
            <span class="hr__n">{String(i + 1).padStart(2, "0")}</span>
            <span class="hr__txt"><em>{c.tag}</em><strong>{c.title}</strong></span>
          </span>
        </button>
      ))}
    </div>
    <div class="wrap"><div class="hr__bar" aria-hidden="true"><span></span></div></div>
  </div>
</section>

<style>
  .hr { position: relative; height: 380vh; --p: 0; background: var(--chalk); }
  .hr__sticky { position: sticky; top: 0; height: 100vh; height: 100svh; display: grid; align-content: center; gap: clamp(1.5rem, 3vw, 2.5rem); overflow: hidden; }
  .hr__head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; }
  .hr__head h2 { max-width: 14ch; }
  .hr__aside { display: grid; gap: 0.9rem; justify-items: start; }
  .hr__count { margin: 0; color: var(--ink-soft); font-size: var(--t-sm); }
  .hr__count span { color: var(--cobalt); font-weight: 700; }
  .hr__track {
    display: flex; gap: clamp(0.9rem, 2vw, 1.5rem); width: max-content;
    padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    transform: translate3d(calc(var(--p) * (100vw - 100%)), 0, 0);
    will-change: transform;
  }
  .hr__card {
    flex: none; width: clamp(280px, 46vw, 680px); display: grid; gap: 1rem; padding: 0; border: 0; background: none;
    color: var(--ink); text-align: left; cursor: pointer;
  }
  .hr__media { position: relative; display: block; aspect-ratio: 16 / 10; border-radius: 22px; overflow: hidden; background: #000; border: 1px solid var(--line); }
  .hr__media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .hr__card:hover .hr__media video { transform: scale(1.05); }
  .hr__card:hover .hr__media { border-color: rgba(212, 248, 12, 0.7); }
  .hr__play {
    position: absolute; right: 1rem; bottom: 1rem; width: 52px; height: 52px; border-radius: 999px; display: grid; place-items: center;
    background: var(--cobalt); color: var(--on-accent); transform: scale(0.8); opacity: 0; transition: transform 0.3s var(--ease), opacity 0.3s;
  }
  .hr__play svg { width: 18px; height: 18px; margin-left: 2px; }
  .hr__card:hover .hr__play, .hr__card:focus-visible .hr__play { transform: none; opacity: 1; }
  .hr__meta { display: flex; gap: 1rem; align-items: baseline; }
  .hr__n { font-size: 0.9rem; font-weight: 700; color: var(--cobalt); }
  .hr__txt { display: grid; gap: 0.15rem; }
  .hr__txt em { font-style: normal; font-size: var(--t-xs); color: var(--ink-soft); }
  .hr__txt strong { font-weight: 560; font-stretch: 88%; text-transform: uppercase; font-size: clamp(1rem, 0.8rem + 0.6vw, 1.3rem); line-height: 1.2; }
  .hr__bar { height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .hr__bar span { display: block; height: 100%; background: var(--cobalt); transform: scaleX(var(--p)); transform-origin: 0 50%; }

  @media (max-width: 760px) {
    .hr { height: auto; padding-block: var(--section); }
    .hr__sticky { position: relative; height: auto; overflow: visible; }
    .hr__track {
      transform: none; width: auto; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 0.5rem;
      scrollbar-width: none; -webkit-overflow-scrolling: touch;
    }
    .hr__track::-webkit-scrollbar { display: none; }
    .hr__card { width: 82vw; scroll-snap-align: center; }
    .hr__bar { display: none; }
  }
  .rm .hr { height: auto; padding-block: var(--section); }
  .rm .hr__sticky { position: relative; height: auto; }
  .rm .hr__track { transform: none; width: auto; overflow-x: auto; }
</style>
