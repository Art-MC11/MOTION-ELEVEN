---
import { poles, allClips } from "../data/content";
// Chaque service est illustré par un extrait vidéo du showreel
const clipFor: Record<string, string> = { web: "mosaique", shop: "mayime", auto: "cosmos", motion: "fun" };
const clipOf = (k: string) => allClips.find((c) => c.slug === clipFor[k])!;
const icons: Record<string, string> = {
  web: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  shop: '<path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/>',
  auto: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M8.2 7.3l2.6 8.4M15.8 7.3l-2.6 8.4M8.5 6h7"/>',
  motion: '<path d="M4 18c4 0 5-12 9-12s5 12 7 12"/><circle cx="13" cy="6" r="1.5"/>',
};
---
<div class="sg">
  {poles.map((p) => (
    <a class="sg__card" href={p.href}>
      <div class="sg__img"><video muted loop playsinline preload="none" poster={clipOf(p.key).poster} data-autoplay data-src={clipOf(p.key).src} aria-hidden="true"></video></div>
      <div class="sg__body">
        <span class="sg__icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={icons[p.key]} /></span>
        <h3>{p.title}</h3>
        <p>{p.promise}</p>
        <span class="sg__more">Découvrir <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="2" /></svg></span>
      </div>
    </a>
  ))}
</div>

<style>
  .sg { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; }
  .sg__card {
    display: grid; grid-template-rows: auto 1fr; border: 1px solid var(--line); border-radius: var(--r-frame);
    background: var(--deep); overflow: hidden; text-decoration: none; color: var(--ink);
    transition: border-color 0.25s var(--ease), transform 0.25s var(--ease);
  }
  .sg__card:hover { border-color: rgba(212, 248, 12, 0.6); transform: translateY(-3px); color: var(--ink); }
  .sg__img { aspect-ratio: 4 / 3; overflow: hidden; background: #000; }
  .sg__img video { display: block; }
  .sg__img video { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); }
  .sg__card:hover .sg__img video { transform: scale(1.06); }
  .sg__body { display: grid; gap: 0.9rem; align-content: start; padding: 1.5rem 1.4rem 1.6rem; }
  .sg__icon { width: 42px; height: 42px; border-radius: 12px; display: grid; place-items: center; background: var(--cobalt-tint); color: var(--cobalt); }
  .sg__icon svg { width: 22px; height: 22px; }
  .sg__body h3 { font-size: 1.15rem; font-weight: 560; font-stretch: 88%; text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.2; }
  .sg__body p { color: var(--ink-soft); font-size: var(--t-sm); margin: 0; }
  .sg__more { display: inline-flex; align-items: center; gap: 0.4rem; font-weight: 600; font-size: var(--t-sm); color: var(--cobalt); margin-top: 0.25rem; }
  .sg__more svg { width: 15px; height: 15px; transition: transform 0.2s var(--ease); }
  .sg__card:hover .sg__more svg { transform: translate(2px, -2px); }
  @media (max-width: 1100px) { .sg { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .sg { grid-template-columns: 1fr; } }
</style>
