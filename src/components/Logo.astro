---
interface Props { tone?: "ink" | "light"; }
const { tone = "ink" } = Astro.props;
---
<a href="/" class:list={["logo", `logo--${tone}`]} aria-label="Motion Eleven, retour à l'accueil">
  <svg class="logo__mark" viewBox="0 0 28 28" aria-hidden="true">
    <rect x="6" y="5" width="5.5" height="18" rx="2.75" />
    <rect class="logo__bar2" x="16.5" y="2" width="5.5" height="18" rx="2.75" />
  </svg>
  <span class="logo__word">Motion Eleven</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--ink); }
  .logo__mark { width: 26px; height: 26px; fill: currentColor; }
  .logo__bar2 { fill: var(--cobalt); transition: transform 0.35s var(--ease); }
  .logo:hover { color: var(--ink); }
  .logo:hover .logo__bar2 { transform: translateY(-2px); }
  .logo__word {
    font-weight: 600; font-stretch: 88%; text-transform: uppercase; letter-spacing: 0.04em; font-size: 1.05rem;
    white-space: nowrap;
  }
</style>
