---
import Logo from "./Logo.astro";
import { nav, site } from "../data/site";
const path = Astro.url.pathname;
const isActive = (href: string) => href !== "/" && path.startsWith(href);
---
<header class="hdr" data-header>
  <div class="wrap hdr__bar">
    <Logo />
    <nav class="hdr__nav" aria-label="Navigation principale">
      <ul class="hdr__list">
        {nav.map((item) => (
          <li class="hdr__item">
            {item.children ? (
              <>
                <button
                  class:list={["hdr__link", { "is-active": item.children.some((c) => isActive(c.href)) || (item.href === "/services/" && isActive("/services/")) }]}
                  aria-expanded="false"
                  aria-controls={`menu-${item.label}`}
                  data-dropdown
                >
                  {item.label === "Zones" ? "Zones d'intervention" : item.label}
                  <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
                </button>
                <div class="hdr__drop" id={`menu-${item.label}`} hidden>
                  <ul>
                    {item.children.map((c) => (
                      <li>
                        <a href={c.href} class:list={{ "is-active": isActive(c.href) }}>
                          <strong>{c.label}</strong>
                          <span>{c.desc}</span>
                        </a>
                      </li>
                    ))}
                    {item.label === "Services" && (
                      <li class="hdr__all"><a href="/services/">Voir tous les services</a></li>
                    )}
                  </ul>
                </div>
              </>
            ) : (
              <a href={item.href} class:list={["hdr__link", { "is-active": isActive(item.href) }]}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <div class="hdr__cta">
      <a href={site.phoneHref} class="hdr__call" aria-label={`Appeler le ${site.phone}`} data-label="header_call">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z" fill="currentColor" /></svg>
        <span>{site.phone.replace("+33 6", "06")}</span>
      </a>
      <a href="/#rendez-vous" class="btn btn--sm hdr__rdv" data-track="cta_click" data-label="header_rdv">Prendre rendez-vous</a>
      <button class="hdr__burger" aria-expanded="false" aria-controls="mobile-menu" data-burger>
        <span class="visually-hidden">Ouvrir le menu</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="mnav" id="mobile-menu" hidden data-mobile>
    <div class="wrap">
      {nav.map((item) => (
        <div class="mnav__group">
          {item.children ? (
            <>
              <p class="mnav__title">{item.label === "Zones" ? "Zones d'intervention" : item.label}</p>
              <ul>
                {item.children.map((c) => (<li><a href={c.href}>{c.label}</a></li>))}
              </ul>
            </>
          ) : (
            <a class="mnav__top" href={item.href}>{item.label}</a>
          )}
        </div>
      ))}
      <a class="mnav__top" href="/a-propos/">À propos</a>
      <a class="mnav__top" href="/contact/">Contact</a>
      <div class="mnav__cta">
        <a href="/#rendez-vous" class="btn" data-track="cta_click" data-label="mobile_menu_rdv">Prendre rendez-vous</a>
        <a href={site.phoneHref} class="btn btn--ghost">Appeler le {site.phone.replace("+33 6", "06")}</a>
      </div>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky; top: 0; z-index: 50;
    background: rgba(10, 10, 11, 0.72);
    backdrop-filter: saturate(1.2) blur(14px);
    -webkit-backdrop-filter: saturate(1.2) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .hdr.is-scrolled { border-bottom-color: var(--line); background: rgba(10, 10, 11, 0.88); }
  .hdr__bar { display: flex; align-items: center; gap: 1.5rem; height: 78px; }
  .hdr__nav { margin-left: auto; }
  .hdr__list { list-style: none; display: flex; gap: 0.15rem; }
  .hdr__item { position: relative; }
  .hdr__link {
    display: inline-flex; align-items: center; gap: 0.35rem;
    padding: 0.6rem 0.8rem; border-radius: 999px;
    font: inherit; font-size: var(--t-sm); font-weight: 520; color: #d6d6d2; white-space: nowrap;
    background: none; border: 0; cursor: pointer; text-decoration: none;
  }
  .hdr__link svg { width: 12px; height: 12px; transition: transform 0.2s; }
  .hdr__link[aria-expanded="true"] svg { transform: rotate(180deg); }
  .hdr__link:hover, .hdr__link[aria-expanded="true"] { background: rgba(255, 255, 255, 0.07); color: var(--ink); }
  .hdr__link.is-active { color: var(--cobalt); }

  .hdr__drop {
    position: absolute; top: calc(100% + 10px); left: -0.5rem; width: 320px;
    background: #161618; border: 1px solid var(--line); border-radius: 18px;
    padding: 0.5rem; box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.9);
  }
  .hdr__drop ul { list-style: none; }
  .hdr__drop a { display: grid; gap: 0.15rem; padding: 0.8rem 0.95rem; border-radius: 12px; text-decoration: none; color: var(--ink); }
  .hdr__drop a:hover { background: rgba(255, 255, 255, 0.06); color: var(--ink); }
  .hdr__drop strong { font-weight: 600; font-size: var(--t-sm); }
  .hdr__drop span { font-size: var(--t-xs); color: var(--ink-soft); }
  .hdr__drop a.is-active strong { color: var(--cobalt); }
  .hdr__all { border-top: 1px solid var(--line); margin-top: 0.4rem; padding-top: 0.4rem; }
  .hdr__all a { font-size: var(--t-sm); font-weight: 600; color: var(--cobalt); }

  .hdr__cta { display: flex; align-items: center; gap: 0.6rem; }
  .hdr__call {
    display: inline-flex; align-items: center; gap: 0.5rem; height: 44px; padding: 0 1rem;
    border: 1.5px solid rgba(255, 255, 255, 0.25); border-radius: 999px;
    font-size: var(--t-sm); font-weight: 600; text-decoration: none; white-space: nowrap;
  }
  .hdr__call svg { width: 16px; height: 16px; color: var(--cobalt); }
  .hdr__call:hover { border-color: var(--cobalt); color: var(--ink); }

  .hdr__burger {
    display: none; width: 46px; height: 46px; border-radius: 999px;
    border: 1.5px solid rgba(255, 255, 255, 0.25); background: transparent; cursor: pointer; position: relative;
  }
  .hdr__burger i {
    position: absolute; left: 13px; right: 13px; height: 2px; background: var(--ink);
    transition: transform 0.25s var(--ease), top 0.25s var(--ease);
  }
  .hdr__burger i:first-of-type { top: 18px; }
  .hdr__burger i:last-of-type { top: 25px; }
  .hdr__burger[aria-expanded="true"] i:first-of-type { top: 21.5px; transform: rotate(45deg); }
  .hdr__burger[aria-expanded="true"] i:last-of-type { top: 21.5px; transform: rotate(-45deg); }

  .mnav {
    position: fixed; inset: 78px 0 0 0; background: var(--paper); overflow-y: auto;
    padding: 1.25rem 0 3rem; border-top: 1px solid var(--line);
  }
  .mnav__group { border-bottom: 1px solid var(--line); padding: 1.1rem 0; }
  .mnav__title { font-size: var(--t-sm); color: var(--ink-soft); margin: 0 0 0.5rem; }
  .mnav ul { list-style: none; display: grid; gap: 0.2rem; }
  .mnav ul a, .mnav__top {
    display: block; padding: 0.45rem 0; text-decoration: none;
    font-size: 1.45rem; font-weight: 560; font-stretch: 88%; text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.2;
  }
  .mnav > .wrap > .mnav__top { border-bottom: 1px solid var(--line); padding: 1rem 0; }
  .mnav__cta { margin-top: 2rem; display: grid; gap: 0.7rem; }
  .mnav__cta .btn { width: 100%; }

  @media (max-width: 1320px) { .hdr__call span { display: none; } .hdr__call { width: 44px; padding: 0; justify-content: center; } }
  @media (max-width: 1180px) {
    .hdr__nav { display: none; }
    .hdr__cta { margin-left: auto; }
    .hdr__burger { display: block; }
  }
  @media (max-width: 560px) {
    .hdr__rdv { display: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const onScroll = () => header?.classList.toggle("is-scrolled", window.scrollY > 8);
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const toggles = document.querySelectorAll<HTMLButtonElement>("[data-dropdown]");
  const closeAll = (except?: HTMLButtonElement) => {
    toggles.forEach((t) => {
      if (t === except) return;
      t.setAttribute("aria-expanded", "false");
      const panel = document.getElementById(t.getAttribute("aria-controls")!);
      if (panel) panel.hidden = true;
    });
  };
  toggles.forEach((btn) => {
    const panel = document.getElementById(btn.getAttribute("aria-controls")!)!;
    const item = btn.parentElement!;
    const open = () => { closeAll(btn); btn.setAttribute("aria-expanded", "true"); panel.hidden = false; };
    const close = () => { btn.setAttribute("aria-expanded", "false"); panel.hidden = true; };
    btn.addEventListener("click", () => (btn.getAttribute("aria-expanded") === "true" ? close() : open()));
    let timer: number | undefined;
    item.addEventListener("mouseenter", () => { if (matchMedia("(hover: hover)").matches) { clearTimeout(timer); open(); } });
    item.addEventListener("mouseleave", () => { if (matchMedia("(hover: hover)").matches) timer = window.setTimeout(close, 140); });
    item.addEventListener("focusout", (e) => { if (!item.contains(e.relatedTarget as Node)) close(); });
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") { closeAll(); closeMobile(); } });
  document.addEventListener("click", (e) => {
    if (!(e.target as HTMLElement).closest(".hdr__item")) closeAll();
  });

  const burger = document.querySelector<HTMLButtonElement>("[data-burger]");
  const mobile = document.querySelector<HTMLElement>("[data-mobile]");
  function closeMobile() {
    if (!burger || !mobile) return;
    burger.setAttribute("aria-expanded", "false");
    mobile.hidden = true;
    document.body.style.overflow = "";
  }
  burger?.addEventListener("click", () => {
    const isOpen = burger.getAttribute("aria-expanded") === "true";
    if (isOpen) return closeMobile();
    burger.setAttribute("aria-expanded", "true");
    mobile!.hidden = false;
    document.body.style.overflow = "hidden";
  });
  mobile?.addEventListener("click", (e) => { if ((e.target as HTMLElement).closest("a")) closeMobile(); });
</script>
