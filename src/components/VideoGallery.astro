---
import { reelClips } from "../data/content";
---
<div class="vg">
  {reelClips.map((c) => (
    <button class="vg__tile" type="button" data-showreel data-t={c.t} aria-label={`Lire le showreel à partir de : ${c.title}`}>
      <video muted loop playsinline preload="none" poster={`/images/showreel/clip-${c.slug}.jpg`} data-clip>
        <source src={`/media/clip-${c.slug}.mp4`} type="video/mp4" />
      </video>
      <span class="vg__cap">
        <em>{c.tag}</em>
        <strong>{c.title}</strong>
      </span>
      <span class="vg__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
    </button>
  ))}
</div>

<style>
  .vg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.9rem; }
  .vg__tile {
    position: relative; display: block; padding: 0; border: 1px solid var(--line); border-radius: 18px; overflow: hidden;
    background: #000; cursor: pointer; aspect-ratio: 16 / 10; text-align: left; color: var(--ink);
  }
  .vg__tile video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease), opacity 0.3s; opacity: 0.85; }
  .vg__tile:hover video, .vg__tile:focus-visible video { transform: scale(1.03); opacity: 1; }
  .vg__tile:hover { border-color: rgba(212, 248, 12, 0.6); }
  .vg__cap {
    position: absolute; left: 0; right: 0; bottom: 0; display: grid; gap: 0.2rem; padding: 2.5rem 1.2rem 1.1rem;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.78));
  }
  .vg__cap em { font-style: normal; font-size: var(--t-xs); color: var(--cobalt); }
  .vg__cap strong { font-weight: 560; font-stretch: 88%; text-transform: uppercase; font-size: 1.05rem; letter-spacing: 0.01em; line-height: 1.2; }
  .vg__play {
    position: absolute; top: 1rem; right: 1rem; width: 42px; height: 42px; border-radius: 999px; display: grid; place-items: center;
    background: rgba(10, 10, 11, 0.55); border: 1px solid rgba(255, 255, 255, 0.25); color: #fff; transition: background 0.2s, color 0.2s;
  }
  .vg__play svg { width: 16px; height: 16px; margin-left: 2px; }
  .vg__tile:hover .vg__play { background: var(--cobalt); color: var(--on-accent); border-color: var(--cobalt); }
  @media (max-width: 900px) { .vg { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .vg { grid-template-columns: 1fr; } }
</style>

<script>
  // Les extraits se lancent quand ils sont visibles (sauf si l'utilisateur préfère réduire les animations)
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clips = document.querySelectorAll<HTMLVideoElement>("[data-clip]");
  if (!reduce && "IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        const v = en.target as HTMLVideoElement;
        if (en.isIntersecting) v.play().catch(() => {});
        else v.pause();
      });
    }, { threshold: 0.35 });
    clips.forEach((v) => io.observe(v));
  }
</script>
