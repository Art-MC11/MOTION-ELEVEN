---
interface Props {
  title: string;
  lede: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  kicker?: string;
}
const { title, lede, primary = { label: "Parler de mon projet", href: "/devis/" }, secondary, kicker } = Astro.props;
---
<section class="ph">
  <div class="wrap ph__grid">
    <div class="ph__text">
      {kicker && <p class="ph__kicker">{kicker}</p>}
      <h1>{title}</h1>
      <p class="lede">{lede}</p>
      <div class="btns">
        <a class="btn" href={primary.href} data-track="cta_click" data-label={`hero_${primary.label}`}>{primary.label}</a>
        {secondary && <a class="btn btn--ghost" href={secondary.href}>{secondary.label}</a>}
      </div>
    </div>
    <div class="ph__aside"><slot /></div>
  </div>
</section>

<style>
  .ph { padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(4rem, 8vw, 7rem); }
  .ph__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .ph__text { display: grid; gap: 1.5rem; }
  .ph h1 { font-size: clamp(2.1rem, 1.3rem + 2.8vw, 3.6rem); }
  .ph__kicker { margin: 0; font-weight: 620; color: var(--cobalt); }
  .ph__aside:empty { display: none; }
  @media (max-width: 900px) { .ph__grid { grid-template-columns: 1fr; } }
</style>
