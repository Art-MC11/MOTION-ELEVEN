---
import { whatsappLink, site } from "../data/site";
interface Props { title?: string; text?: string; }
const {
  title = "Prêt à faire évoluer votre présence digitale ?",
  text = "5 questions, 1 minute. Réponse sous 24 h, sans engagement.",
} = Astro.props;
---
<section class="section section--ink cf">
  <div class="wrap cf__inner">
    <div>
      <h2>{title}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="cf__actions">
      <a href="/devis/" class="btn btn--light" data-track="cta_click" data-label="cta_final_devis">Obtenir mon devis gratuit</a>
      <a href={whatsappLink()} class="btn btn--ghost" target="_blank" rel="noopener" data-track="whatsapp_click" data-label="cta_final">Écrire sur WhatsApp</a>
      <p class="cf__note">{site.responseTime}. Ou appelez le <a href={site.phoneHref}>{site.phone}</a>.</p>
    </div>
  </div>
</section>

<style>
  .cf__inner { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3rem; align-items: end; }
  .cf h2 { margin-bottom: 1.4rem; max-width: 16ch; }
  .cf__actions { display: grid; gap: 0.75rem; }
  .cf__actions .btn { width: 100%; }
  .cf__note { font-size: var(--t-sm); color: #b9b9be; margin-top: 0.5rem; }
  .cf__note a { color: var(--ink); }
  @media (max-width: 860px) { .cf__inner { grid-template-columns: 1fr; } }
</style>
