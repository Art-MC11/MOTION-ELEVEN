---
interface Props { items: { q: string; a: string }[]; title?: string; }
const { items, title = "Questions fréquentes" } = Astro.props;
// Espace fine insécable avant la ponctuation haute (typographie française)
const nb = (t: string) => t.replace(/ ([?!:;])/g, "\u202f$1");
---
<div class="fq">
  <div class="fq__intro">
    <h2>{title}</h2>
    <p class="muted">Une autre question ? <a class="link" href="/contact/">Écrivez-nous</a>, nous répondons sous 24 h ouvrées.</p>
  </div>
  <div class="fq__list">
    {items.map((it) => (
      <details class="fq__item">
        <summary>{nb(it.q)}<span aria-hidden="true"></span></summary>
        <p>{nb(it.a)}</p>
      </details>
    ))}
  </div>
</div>

<style>
  .fq { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); gap: 3rem; }
  .fq__intro h2 { margin-bottom: 1.25rem; }
  .fq__list { border-top: 1px solid var(--line); }
  .fq__item { border-bottom: 1px solid var(--line); }
  .fq__item summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 1.5rem; align-items: center;
    padding: 1.35rem 0; font-weight: 620; font-size: var(--t-md); letter-spacing: -0.01em; line-height: 1.3;
  }
  .fq__item summary::-webkit-details-marker { display: none; }
  .fq__item summary span { flex: none; width: 22px; height: 22px; position: relative; }
  .fq__item summary span::before, .fq__item summary span::after {
    content: ""; position: absolute; left: 3px; right: 3px; top: 10px; height: 2px; background: var(--cobalt);
    transition: transform 0.25s var(--ease);
  }
  .fq__item summary span::after { transform: rotate(90deg); }
  .fq__item[open] summary span::after { transform: rotate(0); }
  .fq__item p { padding: 0 3rem 1.5rem 0; color: var(--ink-soft); max-width: 64ch; }
  @media (max-width: 860px) { .fq { grid-template-columns: 1fr; gap: 1.5rem; } .fq__item p { padding-right: 0; } }
</style>
