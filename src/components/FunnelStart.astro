---
// Entrée du tunnel de vente : la première question du devis, directement dans la page.
// mode "project" : on demande le type de projet. mode "sector" : le projet est connu, on demande l'activité.
import { projectOptions, sectorOptions } from "../data/funnel";
interface Props { mode?: "project" | "sector"; projet?: string; secteur?: string; }
const { mode = "project", projet, secteur } = Astro.props;
const options = mode === "project"
  ? projectOptions.map((o) => ({ label: o.short, href: `/devis/?projet=${o.key}${secteur ? `&secteur=${secteur}` : ""}` }))
  : sectorOptions.slice(0, 5).map((o) => ({ label: o.label, href: `/devis/?secteur=${o.key}${projet ? `&projet=${projet}` : ""}` }));
const question = mode === "project" ? "De quoi avez-vous besoin ?" : "Quelle est votre activité ?";
---
<div class="fs">
  <div class="fs__top">
    <p class="fs__q">{question}</p>
    <p class="fs__meta">Devis gratuit en 1 minute</p>
  </div>
  <div class="fs__bar" aria-hidden="true"><span></span></div>
  <ul class="fs__opts" data-pop>
    {options.map((o, i) => (
      <li style={`--i:${i}`}>
        <a href={o.href} data-track="funnel_start" data-label={o.label}>
          {o.label}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </a>
      </li>
    ))}
  </ul>
  <p class="fs__foot">Réponse sous 24 h. Sans engagement.</p>
</div>

<style>
  .fs {
    background: rgba(20, 20, 22, 0.72); color: var(--ink); border: 1px solid rgba(255, 255, 255, 0.14); border-radius: var(--r-frame);
    padding: clamp(1.4rem, 3vw, 2.1rem); box-shadow: 0 40px 80px -40px rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);
  }
  .fs__top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .fs__q { margin: 0; font-size: var(--t-lg); font-weight: 560; font-stretch: 88%; text-transform: uppercase; letter-spacing: 0.01em; line-height: 1.1; }
  .fs__meta { margin: 0; font-size: var(--t-xs); color: var(--ink-soft); }
  .fs__bar { height: 3px; border-radius: 4px; background: rgba(255,255,255,.12); margin: 1.1rem 0 1.25rem; overflow: hidden; }
  .fs__bar span { display: block; width: 20%; height: 100%; background: var(--cobalt); }
  .fs__opts { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  .fs__opts a {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    min-height: 62px; padding: 0.8rem 1.1rem; border-radius: 14px;
    background: rgba(255, 255, 255, 0.05); border: 1.5px solid rgba(255, 255, 255, 0.12);
    color: var(--ink); text-decoration: none; font-weight: 600; font-size: var(--t-sm); line-height: 1.25;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .fs__opts svg { width: 18px; height: 18px; flex: none; color: var(--cobalt); transition: transform 0.2s var(--ease); }
  .fs__opts a:hover { background: var(--cobalt); border-color: var(--cobalt); color: var(--on-accent); }
  .fs__opts a:hover svg { color: var(--on-accent); transform: translate(2px, -2px); }
  .fs__foot { margin: 1rem 0 0; font-size: var(--t-xs); color: var(--ink-soft); }
  @media (max-width: 380px) { .fs__opts { grid-template-columns: 1fr; } }
</style>
