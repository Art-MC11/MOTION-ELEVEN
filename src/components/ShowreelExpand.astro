---
// Le showreel « s'ouvre » au défilement : la vidéo grandit jusqu'à remplir l'écran
// pendant que le mot SHOWREEL s'écarte de part et d'autre.
---
<section class="sx" data-scrub="pin" aria-label="Showreel Motion Eleven">
  <div class="sx__sticky">
    <p class="sx__word sx__word--l" aria-hidden="true">Show</p>
    <p class="sx__word sx__word--r" aria-hidden="true">reel</p>
    <div class="sx__frame">
      <video muted loop playsinline preload="none" poster="/images/showreel/hero-poster.jpg" data-autoplay data-src="/media/showreel-720.mp4" aria-hidden="true"></video>
    </div>
    <div class="sx__overlay">
        <p class="sx__kicker">Showreel 2025</p>
        <h2>3D, publicité, interfaces, identité : le mouvement au service de votre marque.</h2>
        <button class="btn" type="button" data-showreel data-t="0">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          Regarder avec le son
        </button>
      </div>
  </div>
</section>

<style>
  .sx { position: relative; height: 260vh; --p: 0; }
  .sx__sticky { position: sticky; top: 0; height: 100vh; height: 100svh; display: grid; place-items: center; overflow: hidden; }
  .sx__frame {
    --k: min(1, calc(var(--p) * 1.6));
    position: relative; width: 100vw; height: 100vh; height: 100svh; overflow: hidden; background: #000;
    transform: scale(calc(0.42 + var(--k) * 0.58));
    border-radius: calc((1 - var(--k)) * 40px);
    will-change: transform;
  }
  .sx__frame video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .sx__overlay {
    position: absolute; inset: 0; z-index: 3; display: grid; align-content: end; justify-items: start; gap: 1.25rem;
    padding: clamp(1.5rem, 6vw, 5rem); background: linear-gradient(0deg, rgba(5, 5, 6, 0.85) 0%, rgba(5, 5, 6, 0.1) 55%);
    opacity: clamp(0, calc((var(--p) - 0.55) * 4), 1);
    transform: translateY(calc((1 - clamp(0, calc((var(--p) - 0.55) * 4), 1)) * 30px));
  }
  .sx__overlay h2 { font-size: clamp(1.8rem, 1rem + 3vw, 3.6rem); max-width: 20ch; }
  .sx__kicker { margin: 0; color: var(--cobalt); font-weight: 650; }
  .sx__overlay .btn svg { flex: none; }
  .sx__word {
    position: absolute; top: 50%; z-index: 2; margin: 0; pointer-events: none;
    font-size: clamp(4rem, 1rem + 16vw, 17rem); font-weight: 600; font-stretch: 88%; text-transform: uppercase;
    line-height: 0.9; letter-spacing: -0.02em; color: var(--ink);
    opacity: calc(1 - var(--p) * 2.2);
  }
  .sx__word--l { right: 50%; transform: translate(calc(var(--p) * -70vw), -50%); }
  .sx__word--r { left: 50%; transform: translate(calc(var(--p) * 70vw), -50%); color: #8a8a90; }
  @media (max-width: 760px) {
    .sx { height: 190vh; }
    .sx__frame { height: auto; aspect-ratio: 16 / 9; transform: scale(calc(0.62 + var(--k) * 0.38)); }
    .sx__overlay { background: none; padding: 1.5rem var(--gutter) calc(6.5rem + env(safe-area-inset-bottom)); }
    .sx__word { font-size: 22vw; top: 30%; }
    .sx__kicker { display: none; }
    .sx__overlay h2 { font-size: 1.45rem; }
  }
  .rm .sx { height: auto; }
  .rm .sx__sticky { position: relative; height: auto; }
  .rm .sx__frame { transform: none; border-radius: 0; height: 80vh; }
  .rm .sx__overlay { opacity: 1; transform: none; }
  .rm .sx__word { display: none; }
</style>
